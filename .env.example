# ---------------------------------------------------------------------------
# CineMind — environment template
# Copy to .env and fill in your values. Never commit .env to git.
# ---------------------------------------------------------------------------

# Groq API key — free tier available at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Server bind address and port
HOST=127.0.0.1
PORT=8000

# CORS — comma-separated list of allowed frontend origins
# Development default:
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:4173
# Production example:
# ALLOWED_ORIGINS=https://cinemind.yourdomain.com
